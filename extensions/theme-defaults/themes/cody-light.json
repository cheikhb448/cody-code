{
	"$schema": "vscode://schemas/color-theme",
	"name": "Cody Light",
	"include": "./light_modern.json",
	"type": "light",
	"colors": {
		"focusBorder": "#7c5cffaa",
		"button.background": "#5b5bfe",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#4a4aee",
		"badge.background": "#5b5bfe",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#7c5cff",
		"titleBar.activeBackground": "#f3f6fc",
		"titleBar.border": "#dbe3f1",
		"commandCenter.background": "#ffffff",
		"commandCenter.border": "#cfd9ec",
		"activityBar.background": "#eaf0fa",
		"activityBar.border": "#eaf0fa",
		"activityBar.foreground": "#1d2b4a",
