	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a9955", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.other.class", "keyword.other.function", "keyword.declaration", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#569cd6" } },
		{ "scope": ["keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.conditional", "keyword.control.loop", "keyword.other.namespace", "keyword.other.use", "keyword.control.default"], "settings": { "foreground": "#c586c0" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "entity.name.method", "meta.function-call.generic", "support.function.builtin", "entity.name.function.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#dcdcaa" } },
		{ "scope": ["entity.name.class", "entity.name.type", "entity.name.type.class", "entity.name.type.interface", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace", "entity.name.type.namespace", "entity.name.scope-resolution", "meta.use support.class", "support.other.namespace"], "settings": { "foreground": "#4ec9b0" } },
		{ "scope": ["variable", "variable.other", "variable.other.readwrite", "variable.parameter", "variable.other.object", "meta.definition.variable", "punctuation.definition.variable"], "settings": { "foreground": "#9cdcfe" } },
		{ "scope": ["variable.other.constant", "variable.other.enummember", "constant.other", "support.constant"], "settings": { "foreground": "#4fc1ff" } },
		{ "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"], "settings": { "foreground": "#569cd6" } },
		{ "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template", "string.quoted.docstring"], "settings": { "foreground": "#ce9178" } },
		{ "scope": ["constant.character.escape", "string.regexp.character-class", "constant.other.character-class.regexp"], "settings": { "foreground": "#d7ba7d" } },
		{ "scope": ["string.regexp", "constant.other.character-class.set.regexp"], "settings": { "foreground": "#d16969" } },
		{ "scope": ["constant.numeric", "constant.character", "keyword.other.unit"], "settings": { "foreground": "#b5cea8" } },
		{ "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined"], "settings": { "foreground": "#569cd6" } },
		{ "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor", "keyword.operator.arithmetic", "keyword.operator.assignment", "keyword.operator.comparison"], "settings": { "foreground": "#c8d3e6" } },
		{ "scope": ["punctuation", "meta.brace", "punctuation.section", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block"], "settings": { "foreground": "#a9b7d0" } },
		{ "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"], "settings": { "foreground": "#569cd6" } },
		{ "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"], "settings": { "foreground": "#9cdcfe" } },
		{ "scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property", "variable.object.property", "support.variable.property", "meta.property-name"], "settings": { "foreground": "#9cdcfe" } },
		{ "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"], "settings": { "foreground": "#d7ba7d" } },
		{ "scope": ["support.constant.property-value", "support.constant.font-name", "support.constant.color", "meta.property-value"], "settings": { "foreground": "#ce9178" } },
		{ "scope": ["markup.heading", "markup.heading entity.name", "markup.bold"], "settings": { "foreground": "#569cd6", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "foreground": "#c586c0", "fontStyle": "italic" } },
		{ "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#3794ff" } },
		{ "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#ce9178" } },
		{ "scope": ["markup.quote"], "settings": { "foreground": "#6a9955" } },
		{ "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#b5cea8" } },
		{ "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#ce9178" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f44747" } }
	]
}
