{
	"$schema": "vscode://schemas/color-theme",
	"name": "Cody Dark",
	"include": "./dark_modern.json",
	"type": "dark",
	"colors": {
		"foreground": "#d6e4f5",
		"disabledForeground": "#4d6488",
		"errorForeground": "#ff7a90",
		"descriptionForeground": "#7f9bc4",
		"icon.foreground": "#9fb6d6",
		"focusBorder": "#7c5cff99",
		"selection.background": "#7c5cff66",
		"textLink.foreground": "#53cffa",
		"textLink.activeForeground": "#8fe3ff",
		"textBlockQuote.background": "#0c1d3a",
		"textBlockQuote.border": "#10213f",
		"textCodeBlock.background": "#0c1d3a",
		"widget.shadow": "#00000066",

		"button.background": "#5b5bfe",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#7272ff",
		"button.secondaryBackground": "#0f2449",
		"button.secondaryForeground": "#d6e4f5",
		"button.secondaryHoverBackground": "#163260",
		"badge.background": "#5b5bfe",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#7c5cff",

		"input.background": "#081a33",
		"input.border": "#10213f",
		"input.foreground": "#d6e4f5",
		"input.placeholderForeground": "#5d7eb2",
		"inputOption.activeBackground": "#7c5cff44",
		"inputOption.activeBorder": "#7c5cff",
		"dropdown.background": "#0c1d3a",
		"dropdown.border": "#10213f",
		"dropdown.foreground": "#d6e4f5",
		"dropdown.listBackground": "#0c1d3a",
		"checkbox.background": "#081a33",
		"checkbox.border": "#2a4272",

		"scrollbarSlider.background": "#7f9bc433",
		"scrollbarSlider.hoverBackground": "#7f9bc455",
		"scrollbarSlider.activeBackground": "#7f9bc477",

		"titleBar.activeBackground": "#071224",
		"titleBar.activeForeground": "#d6e4f5",
		"titleBar.inactiveBackground": "#071224",
		"titleBar.inactiveForeground": "#7f9bc4",
		"titleBar.border": "#10213f",
		"commandCenter.background": "#081a33",
		"commandCenter.foreground": "#9fb6d6",
		"commandCenter.activeForeground": "#ffffff",
		"commandCenter.activeBackground": "#0f2449",
		"commandCenter.border": "#1c3560",
		"commandCenter.activeBorder": "#2a4272",
		"commandCenter.inactiveBorder": "#1c3560",

		"activityBar.background": "#061122",
		"activityBar.foreground": "#ffffff",
		"activityBar.inactiveForeground": "#8ba5cc",
		"activityBar.border": "#061122",
		"activityBar.activeBorder": "#00000000",
		"activityBar.activeBackground": "#4b3ba8",
		"activityBarBadge.background": "#5b5bfe",
		"activityBarBadge.foreground": "#ffffff",

		"sideBar.background": "#081425",
		"sideBar.foreground": "#a1cbed",
		"sideBar.border": "#10213f",
		"sideBarTitle.foreground": "#7f9bc4",
		"sideBarSectionHeader.background": "#081425",
		"sideBarSectionHeader.foreground": "#7f9bc4",
		"sideBarSectionHeader.border": "#10213f",

		"list.activeSelectionBackground": "#0f2449",
		"list.activeSelectionForeground": "#ffffff",
		"list.inactiveSelectionBackground": "#0f2449",
		"list.inactiveSelectionForeground": "#ffffff",
		"list.hoverBackground": "#0d1d3a",
		"list.hoverForeground": "#ffffff",
		"list.focusBackground": "#0f2449",
		"list.highlightForeground": "#7ee0ff",
		"tree.indentGuidesStroke": "#16294d",

		"editor.background": "#071224",
		"editor.foreground": "#d6e4f5",
		"editor.lineHighlightBackground": "#0b2040",
		"editor.lineHighlightBorder": "#00000000",
		"editor.selectionBackground": "#2b4a8a99",
		"editor.inactiveSelectionBackground": "#2b4a8a55",
		"editor.selectionHighlightBackground": "#2b4a8a44",
		"editor.wordHighlightBackground": "#2b4a8a55",
		"editor.findMatchBackground": "#7c5cff66",
		"editor.findMatchHighlightBackground": "#7c5cff33",
		"editorCursor.foreground": "#ffffff",
		"editorLineNumber.foreground": "#5d7eb2",
		"editorLineNumber.activeForeground": "#c3d9f3",
		"editorIndentGuide.background1": "#13264a",
		"editorIndentGuide.activeBackground1": "#2a4272",
		"editorWhitespace.foreground": "#1c3560",
		"editorBracketMatch.background": "#7c5cff33",
		"editorBracketMatch.border": "#7c5cff",
		"editorGutter.background": "#071224",
		"editorWidget.background": "#0c1d3a",
		"editorWidget.border": "#1c3560",
		"editorSuggestWidget.background": "#0c1d3a",
		"editorSuggestWidget.border": "#1c3560",
		"editorSuggestWidget.selectedBackground": "#0f2449",
		"editorHoverWidget.background": "#0c1d3a",
		"editorHoverWidget.border": "#1c3560",
		"peekViewEditor.background": "#081a33",
		"peekViewResult.background": "#081425",
		"peekViewTitle.background": "#0c1d3a",

		"editorGroup.border": "#10213f",
		"editorGroupHeader.tabsBackground": "#071224",
		"editorGroupHeader.tabsBorder": "#071224",
		"editorGroupHeader.noTabsBackground": "#071224",
		"tab.activeBackground": "#0c1d3a",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveBackground": "#071224",
		"tab.inactiveForeground": "#8ba5cc",
		"tab.hoverBackground": "#0b1a33",
		"tab.border": "#071224",
		"tab.activeBorder": "#00000000",
		"tab.activeBorderTop": "#00000000",
		"tab.unfocusedActiveBackground": "#0c1d3a",
		"tab.unfocusedActiveForeground": "#c3d9f3",
		"breadcrumb.background": "#081325",
		"breadcrumb.foreground": "#8ba5cc",
		"breadcrumb.focusForeground": "#ffffff",
		"breadcrumb.activeSelectionForeground": "#ffffff",
		"breadcrumbPicker.background": "#0c1d3a",

		"panel.background": "#061122",
		"panel.border": "#10213f",
		"panelTitle.activeForeground": "#ffffff",
		"panelTitle.inactiveForeground": "#9dc4f1",
		"panelTitle.activeBorder": "#7c5cff",
		"panelSectionHeader.background": "#081425",

		"terminal.background": "#061122",
		"terminal.foreground": "#f0fafd",
		"terminal.ansiBlack": "#0c1d3a",
		"terminal.ansiRed": "#ff7a90",
		"terminal.ansiGreen": "#17f5cc",
		"terminal.ansiYellow": "#fcdb50",
		"terminal.ansiBlue": "#53cffa",
		"terminal.ansiMagenta": "#f4b4f6",
		"terminal.ansiCyan": "#35e8f2",
		"terminal.ansiWhite": "#d6e4f5",
		"terminal.ansiBrightBlack": "#5d7eb2",
		"terminal.ansiBrightRed": "#ff9fb0",
		"terminal.ansiBrightGreen": "#5dfbdc",
		"terminal.ansiBrightYellow": "#ffe680",
		"terminal.ansiBrightBlue": "#8fe3ff",
		"terminal.ansiBrightMagenta": "#f9d0fb",
		"terminal.ansiBrightCyan": "#7bf3fa",
		"terminal.ansiBrightWhite": "#ffffff",
		"terminalCursor.foreground": "#ffffff",

		"statusBar.background": "#0a142b",
		"statusBar.foreground": "#b1cef3",
		"statusBar.border": "#10213f",
		"statusBar.noFolderBackground": "#0a142b",
		"statusBar.noFolderForeground": "#b1cef3",
		"statusBar.debuggingBackground": "#7c5cff",
		"statusBar.debuggingForeground": "#ffffff",
		"statusBarItem.hoverBackground": "#13264a",
		"statusBarItem.remoteBackground": "#5b5bfe",
		"statusBarItem.remoteForeground": "#ffffff",

		"menu.background": "#0c1d3a",
		"menu.foreground": "#d6e4f5",
		"menu.selectionBackground": "#0f2449",
		"menu.selectionForeground": "#ffffff",
		"menu.separatorBackground": "#1c3560",
		"menubar.selectionBackground": "#0f2449",
		"quickInput.background": "#0c1d3a",
		"quickInputList.focusBackground": "#0f2449",
		"quickInputTitle.background": "#0c1d3a",
		"notifications.background": "#0c1d3a",
		"notifications.border": "#1c3560",
		"notificationCenterHeader.background": "#081425",
		"notificationToast.border": "#1c3560",
		"settings.headerForeground": "#ffffff",
		"gitDecoration.addedResourceForeground": "#17f5cc",
		"gitDecoration.modifiedResourceForeground": "#fad45e",
		"gitDecoration.untrackedResourceForeground": "#17f5cc",
		"gitDecoration.deletedResourceForeground": "#ff7a90"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6d9ed1", "fontStyle": "" } },
		{ "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other.namespace", "keyword.other.use", "keyword.other.class", "keyword.other.function", "keyword.declaration"], "settings": { "foreground": "#f4b4f6" } },
		{ "scope": ["entity.name.class", "entity.name.type.class", "entity.other.inherited-class", "support.class"], "settings": { "foreground": "#22e5e5" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"], "settings": { "foreground": "#fad45e" } },
		{ "scope": ["entity.name.type", "support.type", "storage.type.class", "meta.use support.class", "entity.name.type.interface"], "settings": { "foreground": "#53cffa" } },
		{ "scope": ["variable", "variable.other", "variable.parameter", "punctuation.definition.variable"], "settings": { "foreground": "#b1bbf7" } },
		{ "scope": ["entity.name.namespace", "entity.name.type.namespace", "meta.namespace", "support.other.namespace", "entity.name.scope-resolution"], "settings": { "foreground": "#f3d27a" } },
		{ "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#f9c54a" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#ffb86b" } },
		{ "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"], "settings": { "foreground": "#98bcda" } },
		{ "scope": ["punctuation", "meta.brace", "punctuation.section", "punctuation.terminator"], "settings": { "foreground": "#c8cff0" } },
		{ "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#f4b4f6" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fad45e" } },
		{ "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#7ee0ff" } },
		{ "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#53cffa", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#f9c54a" } }
	]
}
